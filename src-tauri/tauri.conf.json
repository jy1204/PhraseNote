{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "短语随心记",
  "version": "0.2.3",
  "identifier": "com.jy.tauri-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
  "windows": [
    {
      "title": "短语随心记",
      "width": 540,
      "height": 600,
      "minWidth": 540,
      "minHeight": 600,
      "dragDropEnabled": false
    }
  ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "resources": {
      "resource": "resource"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
